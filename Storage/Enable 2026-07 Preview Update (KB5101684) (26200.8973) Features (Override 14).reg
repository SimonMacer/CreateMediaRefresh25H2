Windows Registry Editor Version 5.00
# Undo - Delete HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control\FeatureManagement\Overrides\14 Registry Key and restore default values.
# You will need to open CMD as administrator. Type the following command in CMD to Undo:
# REG DELETE "HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control\FeatureManagement\Overrides\14" /f

[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control\FeatureManagement\Overrides\14]

## 2026-07 Preview Update (KB5101684) (26200.8973)
# KB5101684 Preview Update Feature Bundle. ViVetool ID: 61160789 (CFR RKey: 2853549198)
[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control\FeatureManagement\Overrides\14\2853549198]
"EnabledState"=dword:00000002
"EnabledStateOptions"=dword:00000000

# Alternate taskbar positions. ViVetool ID: 59213768 (CFR RKey: 2439114895)
# Allows the taskbar to be positioned on any side of the screen (bottom, top, left, or right), providing greater flexibility in how users arrange their workspaces.
[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control\FeatureManagement\Overrides\14\2439114895]
"EnabledState"=dword:00000002
"EnabledStateOptions"=dword:00000000

# Smaller Taskbar. ViVetool ID: 61090762 (CFR RKey: 2486810255)
# Enables a more compact taskbar experience with smaller icons and reduced height, giving users more available screen space for their apps.
[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control\FeatureManagement\Overrides\14\2486810255]
"EnabledState"=dword:00000002
"EnabledStateOptions"=dword:00000000

# File sizes in the Details view now display using appropriate units (KB, MB, GB) instead of KB-only, making them easier to understand at a glance. ViVetool ID: 61014711 (CFR RKey: 1852553359)
[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control\FeatureManagement\Overrides\14\1852553359]
"EnabledState"=dword:00000002
"EnabledStateOptions"=dword:00000000

